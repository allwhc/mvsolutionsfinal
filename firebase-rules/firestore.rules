rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — own doc read/write, superadmin reads all
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());

      // FCM tokens subcollection — owning user can manage their own tokens.
      // Superadmin can also read/revoke so the admin notifications page can
      // show a user's registered devices and clean up stale ones.
      // Cloud Functions use Admin SDK so they bypass these rules.
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      }
    }

    // Orgs — anyone (including unauthenticated) can read, so the
    // /register/org pre-flight check "does this org id already exist?"
    // works before Firebase Auth signup completes AND the /join/<id>
    // invite page can show the org name + spots-left counter without
    // requiring the visitor to be signed in first.
    // Writes are admin-only — memberCount bump happens inside the
    // approve flow using orgAdmin rights; self-join no longer touches
    // the seat count (pending members don't hold seats).
    match /orgs/{orgId} {
      allow read: if true;
      allow write: if request.auth != null && (isOrgAdmin(orgId) || isSuperAdmin());
    }

    // Org Members. Reads for other people's records still restricted
    // to org members + superadmin — one org can't enumerate another
    // org's roster. But a user may ALWAYS read their OWN membership
    // record (self-poll for status change after orgAdmin approves —
    // otherwise a pending user has no way to notice they've been let
    // in without a Cloud Function). Creation loosened: an
    // authenticated user may add THEMSELVES (self-join via invite
    // link); only orgAdmin/superadmin can add other people, update
    // roles, or remove members.
    match /orgMembers/{orgId}/members/{uid} {
      allow read: if request.auth != null && (
        isOrgMember(orgId) || isSuperAdmin() ||
        request.auth.uid == uid   // read own record (pending status poll)
      );
      allow create: if request.auth != null && (
        isOrgAdmin(orgId) || isSuperAdmin() ||
        request.auth.uid == uid   // self-join via invite link
      );
      allow update, delete: if request.auth != null && (isOrgAdmin(orgId) || isSuperAdmin());
    }

    // Org Groups
    match /orgGroups/{orgId}/groups/{groupId} {
      allow read: if request.auth != null && (isOrgMember(orgId) || isSuperAdmin());
      allow write: if request.auth != null && (isOrgAdmin(orgId) || isSuperAdmin());
    }

    // Org Devices — the shared device list for an organisation. Any
    // member sees every device in the org's list (no per-user subscribe
    // dance). Only orgAdmin can add / remove. This replaces the
    // per-user subscriptions model for org accounts.
    match /orgDevices/{orgId}/devices/{deviceCode} {
      allow read: if request.auth != null && (isOrgMember(orgId) || isSuperAdmin());
      allow write: if request.auth != null && (isOrgAdmin(orgId) || isSuperAdmin());
    }

    // Device Catalog — all authenticated can read, authenticated can update (subscriberCount, ownerUid), superadmin full write
    match /deviceCatalog/{deviceCode} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && isSuperAdmin();
      allow update: if request.auth != null;
    }

    // Pending Devices — ESP32 writes (anonymous), superadmin reads/deletes
    match /pendingDevices/{deviceCode} {
      allow read: if request.auth != null && isSuperAdmin();
      allow write: if true; // ESP32 anonymous auth writes here
    }

    // Subscriptions — user manages own, superadmin can read all
    match /subscriptions/{uid}/devices/{deviceCode} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
    }

    // Device Subscribers — read by superadmin, written during subscribe/unsubscribe
    match /deviceSubscribers/{deviceCode}/subscribers/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
    }

    // Device Invites
    match /deviceInvites/{deviceCode}/invites/{inviteId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Plans — anyone can read, superadmin can write
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSuperAdmin();
    }

    // Invites
    match /invites/{inviteId} {
      allow read, write: if request.auth != null;
    }

    // Water tanker order log. Each doc represents ONE tanker delivery
    // (or split delivery across multiple tanks). Scoped either to an
    // individual user or an entire org:
    //   ownerScope = "user"  → scopeId = uid, only that user + superadmin
    //   ownerScope = "org"   → scopeId = orgId, any org member reads,
    //                          any org member creates, orgAdmin edits/deletes
    // Free-tier — no bandwidth concerns at expected volumes (< 100
    // deliveries/month per household). Field validation done client-
    // side; rules only enforce access boundaries.
    match /tankerOrders/{orderId} {
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        (resource.data.ownerScope == "user" && resource.data.scopeId == request.auth.uid) ||
        (resource.data.ownerScope == "org"  && isOrgMember(resource.data.scopeId))
      );
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        (request.resource.data.ownerScope == "user" && request.resource.data.scopeId == request.auth.uid) ||
        (request.resource.data.ownerScope == "org"  && isOrgMember(request.resource.data.scopeId))
      );
      // Edit/delete: individual owners on their own records; orgAdmin
      // (not regular members) on org records; superadmin always.
      allow update, delete: if request.auth != null && (
        isSuperAdmin() ||
        (resource.data.ownerScope == "user" && resource.data.scopeId == request.auth.uid) ||
        (resource.data.ownerScope == "org"  && isOrgAdmin(resource.data.scopeId))
      );
    }

    // Helper functions
    function isSuperAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin";
    }

    function isOrgAdmin(orgId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "orgAdmin"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId;
    }

    function isOrgMember(orgId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId;
    }
  }
}
