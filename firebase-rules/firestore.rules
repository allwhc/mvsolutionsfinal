rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — own doc read/write, superadmin reads all
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());

      // FCM tokens subcollection — owning user can manage their own tokens.
      // Superadmin can also read/revoke so the admin notifications page can
      // show a user's registered devices and clean up stale ones.
      // Cloud Functions use Admin SDK so they bypass these rules.
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      }
    }

    // Orgs — anyone (including unauthenticated) can read, so the
    // /register/org pre-flight check "does this org id already exist?"
    // works before Firebase Auth signup completes. Writes require
    // orgAdmin or superadmin, EXCEPT: a newly authenticated user
    // accepting an invite may bump memberCount by exactly 1 (and touch
    // no other fields), so the /join/<orgId> flow doesn't need a
    // Cloud Function just to keep the "X of 10" counter accurate.
    match /orgs/{orgId} {
      allow read: if true;
      allow create, delete: if request.auth != null && (isOrgAdmin(orgId) || isSuperAdmin());
      allow update: if request.auth != null && (
        isOrgAdmin(orgId) || isSuperAdmin() ||
        // Self-join memberCount bump: only that one field, only +1.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
         && request.resource.data.memberCount == resource.data.memberCount + 1)
      );
    }

    // Org Members. Reads still restricted to members + superadmin so
    // one org can't enumerate another org's roster. Creation loosened:
    // an authenticated user may add THEMSELVES as a member (join flow),
    // but only orgAdmin/superadmin can add other people, update roles,
    // or remove members.
    match /orgMembers/{orgId}/members/{uid} {
      allow read: if request.auth != null && (isOrgMember(orgId) || isSuperAdmin());
      allow create: if request.auth != null && (
        isOrgAdmin(orgId) || isSuperAdmin() ||
        request.auth.uid == uid   // self-join via invite link
      );
      allow update, delete: if request.auth != null && (isOrgAdmin(orgId) || isSuperAdmin());
    }

    // Org Groups
    match /orgGroups/{orgId}/groups/{groupId} {
      allow read: if request.auth != null && (isOrgMember(orgId) || isSuperAdmin());
      allow write: if request.auth != null && (isOrgAdmin(orgId) || isSuperAdmin());
    }

    // Org Devices — the shared device list for an organisation. Any
    // member sees every device in the org's list (no per-user subscribe
    // dance). Only orgAdmin can add / remove. This replaces the
    // per-user subscriptions model for org accounts.
    match /orgDevices/{orgId}/devices/{deviceCode} {
      allow read: if request.auth != null && (isOrgMember(orgId) || isSuperAdmin());
      allow write: if request.auth != null && (isOrgAdmin(orgId) || isSuperAdmin());
    }

    // Device Catalog — all authenticated can read, authenticated can update (subscriberCount, ownerUid), superadmin full write
    match /deviceCatalog/{deviceCode} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && isSuperAdmin();
      allow update: if request.auth != null;
    }

    // Pending Devices — ESP32 writes (anonymous), superadmin reads/deletes
    match /pendingDevices/{deviceCode} {
      allow read: if request.auth != null && isSuperAdmin();
      allow write: if true; // ESP32 anonymous auth writes here
    }

    // Subscriptions — user manages own, superadmin can read all
    match /subscriptions/{uid}/devices/{deviceCode} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
    }

    // Device Subscribers — read by superadmin, written during subscribe/unsubscribe
    match /deviceSubscribers/{deviceCode}/subscribers/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
    }

    // Device Invites
    match /deviceInvites/{deviceCode}/invites/{inviteId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Plans — anyone can read, superadmin can write
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSuperAdmin();
    }

    // Invites
    match /invites/{inviteId} {
      allow read, write: if request.auth != null;
    }

    // Helper functions
    function isSuperAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "superadmin";
    }

    function isOrgAdmin(orgId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "orgAdmin"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId;
    }

    function isOrgMember(orgId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId;
    }
  }
}
